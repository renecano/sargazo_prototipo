{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,data/semar/dirmarea.txt,docs/validacion/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
